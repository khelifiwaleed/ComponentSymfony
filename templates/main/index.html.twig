<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8" />
    <title>Inscription Étape par Étape</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        .error-message {
            color: #dc3545;
            font-size: 0.875em;
            margin-top: 0.25rem;
            display: none;
        }
        input.is-invalid {
            border-color: #dc3545;
            box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
        }
        .step {
            display: none;
        }
        .step.active {
            display: block;
        }
    </style>
</head>
<body class="bg-light">

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-4 text-center">Créer un compte {{ name }}</h3>

                    <form id="stepForm" novalidate>
                        <!-- Étape 1 : Nom -->
                        <div class="step active" data-step="1">
                            <label for="name" class="form-label">Nom complet</label>
                            <input type="text" class="form-control" id="name" name="name" required />
                            <div class="error-message">Le nom est requis.</div>
                            <button type="button" class="btn btn-primary mt-3" id="next1">Suivant</button>
                        </div>

                        <!-- Étape 2 : Email -->
                        <div class="step" data-step="2">
                            <label for="email" class="form-label">Adresse email</label>
                            <input type="email" class="form-control" id="email" name="email" required />
                            <div class="error-message">Veuillez saisir un email valide.</div>
                            <button type="button" class="btn btn-secondary mt-3 me-2" id="prev2">Précédent</button>
                            <button type="button" class="btn btn-primary mt-3" id="next2">Suivant</button>
                        </div>

                        <!-- Étape 3 : Mot de passe -->
                        <div class="step" data-step="3">
                            <label for="password" class="form-label">Mot de passe</label>
                            <input type="password" class="form-control" id="password" name="password" required minlength="6" />
                            <div class="error-message">Le mot de passe doit contenir au moins 6 caractères.</div>
                            <button type="button" class="btn btn-secondary mt-3 me-2" id="prev3">Précédent</button>
                            <button type="button" class="btn btn-primary mt-3" id="next3">Suivant</button>
                        </div>

                        <!-- Étape 4 : Confirmation mot de passe -->
                        <div class="step" data-step="4">
                            <label for="confirm_password" class="form-label">Confirmer le mot de passe</label>
                            <input type="password" class="form-control" id="confirm_password" name="confirm_password" required />
                            <div class="error-message" id="confirmError">Les mots de passe ne correspondent pas.</div>
                            <button type="button" class="btn btn-secondary mt-3 me-2" id="prev4">Précédent</button>
                            <button type="submit" class="btn btn-success mt-3">S'inscrire</button>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    const form = document.getElementById('stepForm');
    const steps = document.querySelectorAll('.step');

    // Afficher une étape par son index (0-based)
    function showStep(index) {
        steps.forEach((step, i) => {
            step.classList.toggle('active', i === index);
        });
    }

    // Validation simple d'un champ
    function validateInput(input) {
        if (!input.checkValidity()) {
            input.classList.add('is-invalid');
            input.nextElementSibling.style.display = 'block'; // afficher message d'erreur
            return false;
        }
        input.classList.remove('is-invalid');
        input.nextElementSibling.style.display = 'none';
        return true;
    }

    // Étape 1 : nom
    document.getElementById('next1').addEventListener('click', () => {
        const name = document.getElementById('name');
        if (validateInput(name)) {
            showStep(1);
        }
    });

    // Étape 2 : email
    document.getElementById('prev2').addEventListener('click', () => showStep(0));
    document.getElementById('next2').addEventListener('click', () => {
        const email = document.getElementById('email');
        if (validateInput(email)) {
            showStep(2);
        }
    });

    // Étape 3 : password
    document.getElementById('prev3').addEventListener('click', () => showStep(1));
    document.getElementById('next3').addEventListener('click', () => {
        const password = document.getElementById('password');
        if (validateInput(password)) {
            showStep(3);
        }
    });

    // Étape 4 : confirm password + validation correspondance
    document.getElementById('prev4').addEventListener('click', () => showStep(2));
    form.addEventListener('submit', (e) => {
        e.preventDefault();

        const password = document.getElementById('password');
        const confirmPassword = document.getElementById('confirm_password');
        const confirmError = document.getElementById('confirmError');

        // Reset erreurs
        confirmPassword.classList.remove('is-invalid');
        confirmError.style.display = 'none';

        // Validation confirm password
        if (!validateInput(confirmPassword)) return;

        if (password.value !== confirmPassword.value) {
            confirmPassword.classList.add('is-invalid');
            confirmError.style.display = 'block';
            confirmPassword.focus();
            return;
        }

        // Ici tu peux envoyer le formulaire (par fetch/Ajax ou formulaire classique)
        alert('Formulaire validé, prêt à envoyer !');
        form.submit(); // ou ta logique ajax ici
    });
</script>

</body>
</html>